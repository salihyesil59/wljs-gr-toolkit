<|"Public" -> Hold[Dataset[{Association["check" -> "u.u = -1 to first order, so the velocity is a free function", "ok" -> True], Association["check" -> "matter conservation gives the background continuity equation", "ok" -> True], Association["check" -> "the traceless equation is exactly -k^2 (fR (phi - psi) - fRR dR)", "ok" -> True], Association["check" -> "at fRR = 0 the slip relation returns phi = psi", "ok" -> True], Association["check" -> "the trace equation is fourth order in phi before the reduction", "ok" -> True], Association["check" -> "after the reduction nothing is above first order in phi", "ok" -> True], Association["check" -> "the scalaron carries the second derivative instead", "ok" -> True], Association["check" -> "freezing fR to a constant changes the trace equation", "ok" -> True], Association["acceptance test" -> "quasi-static plus sub-horizon reproduces GR-05's G_eff exactly", "ok" -> True], Association["acceptance test" -> "the LCDM background solves the f(R) background to order |fR0|", "ok" -> True], Association["acceptance test" -> "mu_GR tends to 1 well inside the horizon", "ok" -> True], Association["check" -> "mu_GR is suppressed near the horizon, which is not an f(R) effect", "ok" -> True], Association["check" -> "the raw error falls roughly as (aH/k)^2", "ok" -> True], Association["check" -> "dividing out the relativistic correction shrinks the error at every k", "ok" -> True], Association["acceptance test" -> "the modification error, per unit of modification, falls with k", "ok" -> True], Association["check" -> "and is under 5% of the modification even at k = 3 aH", "ok" -> True], Association["check" -> "and under 1% of it by k = 20 aH", "ok" -> True], Association["check" -> "the two insensitivity runs really did start from different values", "ok" -> True], Association["check" -> "and the answer does not remember either choice", "ok" -> True]}, TypeSystem`Vector[TypeSystem`Assoc[TypeSystem`Atom[String], TypeSystem`AnyType, TypeSystem`AnyLength], 19], Association[]]]|>

