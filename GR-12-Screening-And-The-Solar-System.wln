<|"Public" -> Hold[Dataset[{Association["acceptance test" -> "the two contractions behind the trace identity hold", "ok" -> True], Association["check" -> "the metric trace is 4 in four dimensions", "ok" -> True], Association["acceptance test" -> "the massless scalaron responds as -2/3 of the Newtonian potential", "ok" -> True], Association["check" -> "the same ratio holds inside and outside the body", "ok" -> True], Association["acceptance test" -> "an unscreened scalaron gives PPN gamma = 1/2", "ok" -> True], Association["check" -> "which is GR-05's slip in the small-scale limit", "ok" -> True], Association["check" -> "Cassini allows a fifth-force fraction of a few parts in 10^5", "ok" -> True], Association["check" -> "the shell solution obeys the shell equation", "ok" -> True], Association["check" -> "and is pinned with zero slope at the core radius", "ok" -> True], Association["acceptance test" -> "matching gives xs = Sqrt[1 - eps]", "ok" -> True], Association["acceptance test" -> "the screening factor is 1 - (1-eps)^(3/2)", "ok" -> True], Association["check" -> "no core survives once eps reaches 1, and the body is bare", "ok" -> True], Association["check" -> "for a deeply screened body the factor is linear in eps", "ok" -> True], Association["check" -> "screening is monotone: a smaller background field screens harder", "ok" -> True], Association["check" -> "the field near the pinned core rises as (x - xs)^2 / eps", "ok" -> True], Association["acceptance test" -> "the pinned-core idealisation is negligible for a real body", "ok" -> True], Association["check" -> "and is still small for the Galaxy, where the contrast is only 10^6", "ok" -> True], Association["acceptance test" -> "requiring the Galaxy to screen gives |fR0| < 10^-6", "ok" -> True], Association["check" -> "an unaided Sun would be bound far more tightly than the Galaxy route", "ok" -> True]}, TypeSystem`Vector[TypeSystem`Assoc[TypeSystem`Atom[String], TypeSystem`AnyType, TypeSystem`AnyLength], 19], Association[]]]|>

